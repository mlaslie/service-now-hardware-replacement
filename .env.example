# Deployment settings. Copy to .env and fill in:   cp .env.example .env
# .env is read by the agent when run locally and by scripts/*.sh and seed/*.py; it is never
# committed (see .gitignore) and never copied into the container. scripts/deploy.sh passes these
# values to Cloud Run. Every variable is explained in docs/CONFIGURATION.md.
#
# What the agent SAYS and DOES for your organization (name, colours, problem choices...) is not
# here: that is config/organization.yaml.

# --- Required ------------------------------------------------------------------------
# Google Cloud project that runs the agent.
GOOGLE_CLOUD_PROJECT=
# Your ServiceNow instance, https://<name>.service-now.com
SN_INSTANCE_URL=
# ID of the Agent Runtime instance that stores conversations and memory. scripts/setup.sh creates
# one and prints its ID.
AGENT_ENGINE_ID=

# --- Optional (defaults shown) ---------------------------------------------------------
# Region for Cloud Run, the bucket and the Agent Runtime instance.
REGION=us-central1
# Cloud Run service name.
SERVICE_NAME=hardware-replacement-agent
# Gemini model, and where it is served from (gemini-3.8-flash is served from "global").
MODEL=gemini-3.8-flash
GOOGLE_CLOUD_LOCATION=global
# Agent Runtime instance location (defaults to REGION).
# AGENT_ENGINE_LOCATION=us-central1
# Bucket for users' photos (defaults to <project>-hardware-ticket-photos).
# ARTIFACT_BUCKET=
# Organization profile (defaults to config/organization.yaml).
# ORGANIZATION_PROFILE=config/organization.yaml

# --- Set by scripts/deploy.sh on Cloud Run; only for local runs --------------------------
# SERVICE_URL=http://localhost:8080
